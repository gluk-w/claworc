#!/usr/bin/env bash
# meta — Claworc agent shim capability probe (docs/shim.md, contract v1).
# Pure bash, no jq: the JSON is a static heredoc. Keep it in sync with the
# verbs you actually implement — `capabilities` gates the Claworc UI.
#
# Skills: the `skills` capability means Claworc installs and removes skills
# through the skill-install / skill-remove verbs, which unpack them into
# skills_dir/<skill-name>/. Point skills_dir (and SKILLS_DIR in those verbs)
# at wherever your agent loads skills from, or drop the capability.
set -euo pipefail

cat <<'EOF'
{
  "contract": 1,
  "shim_version": "0.1.0",
  "agent": {"name": "template"},
  "capabilities": ["chat", "chat.stream", "chat.abort", "session.reset", "config", "configure-llm", "restart", "skills"],
  "config_files": [
    {"id": "main", "path": "/opt/claworc/shim/agent.env", "language": "shell", "label": "agent.env", "restart_required": false}
  ],
  "workspace_dir": "/home/claworc/workspace",
  "skills_dir": "/home/claworc/skills",
  "log_files": [{"path": "/var/log/claworc/agent.log", "label": "Agent"}],
  "llm": {"styles": ["openai"]},
  "session_persistence": "none"
}
EOF
