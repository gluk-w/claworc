#!/bin/sh
# restart — restart the agent service (docs/shim.md). Exit 0 when accepted.
#
# svc-agent runs the shim supervisor (lib/host.mjs), which traps TERM and
# SIGTERMs every agent-runner child before exiting, so a plain `s6-svc -r`
# cleanly recycles the whole NanoClaw stack; s6 respawns the supervisor,
# which lazily respawns runners for sessions with pending work.
set -eu

SVC_DIR=/run/service/svc-agent
if [ ! -d "$SVC_DIR" ]; then
    echo "svc-agent service directory missing: $SVC_DIR" >&2
    exit 1
fi
exec /command/s6-svc -r "$SVC_DIR"
