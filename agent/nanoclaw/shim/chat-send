#!/usr/bin/env bash
# chat-send --session <key> [--turn <id>] — stream one chat turn as JSONL
# (docs/shim.md). Thin wrapper: verbs run as root over SSH but agent state
# must stay claworc-owned, so drop privileges and exec the Bun implementation
# in lib/. Bun is used because bun:sqlite is the same SQLite driver
# NanoClaw's own agent-runner uses — no dependency of our own.
set -euo pipefail
source "$(dirname "$0")/lib/shimlib.sh"

BUN=${CLAWORC_SHIM_BUN:-/usr/local/bin/bun}

run_as_claworc "$BUN" "$SHIM_DIR/lib/chat-send.mjs" "$@"
