#!/usr/bin/env bash
# config-set [--id <file-id>] — replace a Hermes config file with stdin, byte
# for byte (docs/shim.md). ids: "config" -> ~/.hermes/config.yaml (default),
# "env" -> ~/.hermes/.env. No validation (the frontend validates by meta's
# `language`); never restarts the agent — each chat turn re-reads these files.
set -euo pipefail
source "$(dirname "$0")/lib/shimlib.sh"

parse_id_arg config config env -- "$@"
case "$SHIM_ID" in
    config) FILE=/home/claworc/.hermes/config.yaml ;;
    env)    FILE=/home/claworc/.hermes/.env ;;
esac

# Lazily seed ~/.hermes when the s6 boot sequence has not run.
[[ -d /home/claworc/.hermes ]] || "$SHIM_DIR/lib/ensure-seed.sh" || true
atomic_write "$FILE" 0644
