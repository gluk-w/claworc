#!/bin/sh
# session-reset --session <key> — clear conversation history for the key by
# dropping its Claworc-key -> Hermes-session-id mapping; the next chat-send
# starts a fresh Hermes session. Idempotent (docs/shim.md).
#
# The old Hermes session rows stay in ~/.hermes SQLite (harmless — they are
# simply never resumed again), which also preserves Hermes' own cross-session
# recall features.
set -eu

STATE_DIR=${CLAWORC_SHIM_STATE_DIR:-/home/claworc/.claworc/shim}

SESSION=""
while [ $# -gt 0 ]; do
    case "$1" in
        --session) SESSION="$2"; shift 2 ;;
        *) echo "unknown argument: $1" >&2; exit 2 ;;
    esac
done
[ -n "$SESSION" ] || { echo "--session is required" >&2; exit 2; }

SESSION_FILE=$(printf %s "$SESSION" | tr -c 'A-Za-z0-9._-' '_')
rm -f "$STATE_DIR/hermes-sessions/$SESSION_FILE.id"
exit 0
